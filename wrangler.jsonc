{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova0new",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "8806af2d-4179-4db4-992f-9eeb52bd06f6","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "6553a178d96a4c62962344c3d5926399" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
